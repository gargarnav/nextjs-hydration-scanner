{
  "version": "1.0.0",
  "description": "Canonical sensitive field and value patterns shared between eslint-plugin-ssr-boundary and ssr-boundary-scanner",
  "field_patterns": [
    { "pattern": "password_hash",     "severity": "CRITICAL", "label": "Password hash" },
    { "pattern": "hashed_password",   "severity": "CRITICAL", "label": "Password hash" },
    { "pattern": "password",          "severity": "CRITICAL", "label": "Password field" },
    { "pattern": "passwd",            "severity": "CRITICAL", "label": "Password field" },
    { "pattern": "two_factor_secret", "severity": "CRITICAL", "label": "2FA seed / TOTP secret" },
    { "pattern": "totp_secret",       "severity": "CRITICAL", "label": "2FA seed / TOTP secret" },
    { "pattern": "otp_secret",        "severity": "CRITICAL", "label": "2FA seed / TOTP secret" },
    { "pattern": "private_key",       "severity": "CRITICAL", "label": "Private key" },
    { "pattern": "privateKey",        "severity": "CRITICAL", "label": "Private key (camelCase)" },
    { "pattern": "api_key",           "severity": "CRITICAL", "label": "API key" },
    { "pattern": "apiKey",            "severity": "CRITICAL", "label": "API key (camelCase)" },
    { "pattern": "apikey",            "severity": "CRITICAL", "label": "API key" },
    { "pattern": "social_security",   "severity": "CRITICAL", "label": "Social Security Number" },
    { "pattern": "ssn",               "severity": "CRITICAL", "label": "Social Security Number" },
    { "pattern": "credit_card",       "severity": "CRITICAL", "label": "Credit card number" },
    { "pattern": "creditCard",        "severity": "CRITICAL", "label": "Credit card number (camelCase)" },
    { "pattern": "card_number",       "severity": "CRITICAL", "label": "Credit card number" },
    { "pattern": "cardNumber",        "severity": "CRITICAL", "label": "Credit card number (camelCase)" },
    { "pattern": "cvv",               "severity": "CRITICAL", "label": "CVV / CVC" },
    { "pattern": "access_token",      "severity": "HIGH",     "label": "Access token" },
    { "pattern": "accessToken",       "severity": "HIGH",     "label": "Access token (camelCase)" },
    { "pattern": "refresh_token",     "severity": "HIGH",     "label": "Refresh token" },
    { "pattern": "refreshToken",      "severity": "HIGH",     "label": "Refresh token (camelCase)" },
    { "pattern": "auth_token",        "severity": "HIGH",     "label": "Auth token" },
    { "pattern": "authToken",         "severity": "HIGH",     "label": "Auth token (camelCase)" },
    { "pattern": "session_token",     "severity": "HIGH",     "label": "Session token" },
    { "pattern": "sessionToken",      "severity": "HIGH",     "label": "Session token (camelCase)" },
    { "pattern": "\\btoken\\b",       "severity": "HIGH",     "label": "Token field", "is_regex": true },
    { "pattern": "jwt",               "severity": "HIGH",     "label": "JWT" },
    { "pattern": "bearer",            "severity": "HIGH",     "label": "Bearer credential" },
    { "pattern": "encryption_key",    "severity": "HIGH",     "label": "Encryption key" },
    { "pattern": "encryptionKey",     "severity": "HIGH",     "label": "Encryption key (camelCase)" },
    { "pattern": "signing_key",       "severity": "HIGH",     "label": "Signing key" },
    { "pattern": "signingKey",        "severity": "HIGH",     "label": "Signing key (camelCase)" },
    { "pattern": "webhook_secret",    "severity": "MEDIUM",   "label": "Webhook secret" },
    { "pattern": "webhookSecret",     "severity": "MEDIUM",   "label": "Webhook secret (camelCase)" },
    { "pattern": "secret",            "severity": "CRITICAL", "label": "Secret / key material" },
    { "pattern": "internal_id",       "severity": "MEDIUM",   "label": "Internal identifier" },
    { "pattern": "internalId",        "severity": "MEDIUM",   "label": "Internal identifier (camelCase)" },
    { "pattern": "is_admin",          "severity": "MEDIUM",   "label": "Admin flag" },
    { "pattern": "isAdmin",           "severity": "MEDIUM",   "label": "Admin flag (camelCase)" },
    { "pattern": "\\badmin\\b",        "severity": "MEDIUM",   "label": "Admin flag / role", "is_regex": true },
    { "pattern": "stripe_customer",   "severity": "MEDIUM",   "label": "Stripe customer ID" },
    { "pattern": "stripeCustomer",    "severity": "MEDIUM",   "label": "Stripe customer ID (camelCase)" }
  ],
  "value_patterns": [
    { "pattern": "^\\$2[aby]\\$\\d+\\$.{53}$",                              "severity": "CRITICAL", "label": "Bcrypt hash" },
    { "pattern": "^sk_(live|test)_[A-Za-z0-9]{16,}$",                       "severity": "CRITICAL", "label": "Stripe-style live API key" },
    { "pattern": "^\\d{3}-\\d{2}-\\d{4}$",                                  "severity": "CRITICAL", "label": "SSN (XXX-XX-XXXX format)" },
    { "pattern": "ghp_[A-Za-z0-9]{36}",                                     "severity": "CRITICAL", "label": "GitHub Personal Access Token" },
    { "pattern": "AKIA[0-9A-Z]{16}",                                        "severity": "CRITICAL", "label": "AWS Access Key ID" },
    { "pattern": "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",   "severity": "HIGH",     "label": "JWT token" },
    { "pattern": "^[0-9]{13,16}$",                                          "severity": "HIGH",     "label": "Possible credit card number" },
    { "pattern": "^[A-Z2-7]{16,}=*$",                                        "severity": "HIGH",     "label": "Base32 string (possible TOTP secret)", "flags": "i" }
  ]
}
